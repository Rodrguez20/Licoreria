
@{
    ViewData["Title"] = "Negocio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Estilos {
    <style>
        /* Card moderno con sombra y bordes redondeados */
        .card {
            border-radius: 1rem;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 25px rgba(0,0,0,0.2);
            }

        /* Header de la card con gradiente */
        .card-header.bg-second-primary {
            background: linear-gradient(135deg, #6dd5ed, #2193b0);
            color: #fff;
            font-weight: 700;
        }

        /* Inputs modernos */
        .form-control, .form-control-file, .form-control-sm {
            border-radius: 0.5rem;
            transition: border-color 0.3s, box-shadow 0.3s;
        }

            .form-control:focus, .form-control-file:focus, .form-control-sm:focus {
                border-color: #2193b0;
                box-shadow: 0 0 8px rgba(33,147,176,0.4);
            }

        /* Botón guardar con flow */
        #btnGuardarCambios {
            border-radius: 50px;
            font-weight: 600;
            transition: background 0.3s, transform 0.2s;
        }

            #btnGuardarCambios:hover {
                background: #28a745cc;
                transform: translateY(-2px);
            }
    </style>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">Datos del Negocio</h6>
    </div>
    <div class="card-body">

        <div class="row">
            <div class="col-sm-12">
                <form>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-row">
                                <div class="form-group col-sm-6">
                                    <label for="txtNumeroDocumento">Numero Documento</label>
                                    <input type="text" class="form-control form-control-sm input-validar" id="txtNumeroDocumento" name="Numero Documento">
                                </div>
                                <div class="form-group col-sm-6">
                                    <label for="txtCorreo">Razon Social</label>
                                    <input type="text" class="form-control form-control-sm input-validar" id="txtRazonSocial" name="Razon Social">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-sm-6">
                                    <label for="txtCorreo">Correo</label>
                                    <input type="email" class="form-control form-control-sm input-validar" id="txtCorreo" name="Correo">
                                </div>
                                <div class="form-group col-sm-6">
                                    <label for="txtDireccion">Direccion</label>
                                    <input type="text" class="form-control form-control-sm input-validar" id="txtDireccion" name="Direccion">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-sm-6">
                                    <label for="txTelefono">Telefono</label>
                                    <input type="text" class="form-control form-control-sm input-validar" id="txtTelefono" name="Telefono">
                                </div>
                                <div class="form-group col-sm-6">
                                    <label for="txtImpuesto">% Impuesto</label>
                                    <input type="text" class="form-control form-control-sm input-validar" id="txtImpuesto" name="Impuesto">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-sm-6">
                                    <label for="txtSimboloMoneda">Simbolo Moneda</label>
                                    <input type="text" class="form-control form-control-sm input-validar" id="txtSimboloMoneda" name="Simbolo Moneda">
                                </div>
                                <div class="form-group col-sm-6">
                                    <label for="txtLogo">Logo</label>
                                    <input class="form-control-file" type="file" id="txtLogo" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="row">
                                <div class="col-sm-12">
                                    <img id="imgLogo" style="max-width:200px;" src="" class="rounded" alt="Logo">
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col-sm-12">
                                    <button class="btn btn-success btn-sm" type="button" id="btnGuardarCambios">Guardar Cambios</button>
                                </div>
                            </div>

                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
 
    <script src="~/js/vistas/Negocio_Index.js"></script>
    
}
