@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>EnviarClave</title>
    <style>
        body {
            background: linear-gradient(135deg, #EDF6FF, #DFF6FF);
            font-family: 'Nunito', sans-serif;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 450px;
            margin: 80px auto;
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            padding: 30px 25px;
            text-align: center;
            transition: transform 0.3s ease;
        }

            .container:hover {
                transform: translateY(-5px);
            }

        h2 {
            color: #004DAF;
            margin-bottom: 15px;
        }

        p {
            font-size: 0.95rem;
            color: #333;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            margin-bottom: 20px;
            text-align: left;
        }

            table td h4 {
                color: #004DAF;
                margin: 0;
                font-weight: 600;
            }

        .alert {
            background-color: #FFE1CE;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            color: #F45E00;
            font-weight: 500;
        }

        a.btn-login {
            display: inline-block;
            background: linear-gradient(90deg, #1CC88A, #17A673);
            color: #fff;
            font-weight: 600;
            padding: 10px 25px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.3s ease;
        }

            a.btn-login:hover {
                background: linear-gradient(90deg, #17A673, #138758);
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            }
    </style>
</head>
<body>
    <div class="container">
        <h2>Bienvenido</h2>
        <p>Se creó exitosamente tu usuario. Los detalles de tu cuenta son:</p>
        <table>
            <tr>
                <td><h4>Correo:</h4></td>
                <td>@ViewData["Correo"]</td>
            </tr>
            <tr>
                <td><h4>Contraseña:</h4></td>
                <td>@ViewData["Clave"]</td>
            </tr>
        </table>
        <div class="alert">
            Le recomendamos cambiar la contraseña una vez inicie sesión.
        </div>
        <p>Para iniciar sesión ingrese a la siguiente URL:</p>
        <a class="btn-login" href="@ViewData["Url"]">Iniciar Sesión</a>
    </div>
</body>
</html>
