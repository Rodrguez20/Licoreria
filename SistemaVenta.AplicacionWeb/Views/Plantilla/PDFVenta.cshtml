@model SistemaVenta.AplicacionWeb.Models.ViewModels.VMPDFVenta;
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ImprimirVenta</title>
    <style>
        body {
            font-family: 'Nunito', Arial, Helvetica, sans-serif;
            background-color: #f4f7f9;
            margin: 0;
            padding: 0;
        }

        .contenedor {
            width: 900px;
            margin: 40px auto;
            background-color: #ffffff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        }

        img {
            border-radius: 8px;
        }

        p.title {
            font-weight: bold;
            font-size: 18px;
            color: #333;
            margin-bottom: 5px;
        }

        p.title2 {
            font-weight: bold;
            color: #03A99F;
            font-size: 22px;
            margin-bottom: 5px;
        }

        p.text {
            font-size: 14px;
            color: #555;
            margin: 2px 0;
        }

        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 4px;
        }

            table.tbproductos thead tr th {
                background-color: #03A99F;
                padding: 12px;
                font-size: 15px;
                color: white;
                border-radius: 4px;
            }

            table.tbproductos tbody tr td {
                padding: 10px;
                vertical-align: middle;
            }

        .td-item {
            border-bottom: 2px solid #E8E8E8;
        }

        .item {
            font-size: 15px;
            color: #757575;
        }

        .item-2 {
            font-size: 15px;
            font-weight: bold;
            color: #555;
        }

        .item-3 {
            font-size: 15px;
            font-weight: bold;
            background-color: #03A99F;
            color: white;
            text-align: center;
            border-radius: 4px;
        }

        /* Resaltar fila de total final */
        table.tbproductos tbody tr:last-child td.item-3 {
            background-color: #017C68;
        }

        /* Separador visual */
        .separator {
            height: 2px;
            background-color: #03A99F;
            margin: 20px 0;
            border-radius: 2px;
        }
    </style>
</head>
<body>

    <div class="contenedor">

        <!-- Encabezado con logo y número de venta -->
        <table>
            <tr>
                <td>
                    <img src="@Model.negocio.UrlLogo" style="width: 120px; height:120px" />
                </td>
                <td style="text-align:right">
                    <table style="margin-left:auto">
                        <tr><td><p class="title2">NÚMERO VENTA</p></td></tr>
                        <tr><td>@Model.venta.NumeroVenta</td></tr>
                    </table>
                </td>
            </tr>
        </table>

        <div class="separator"></div>

        <!-- Datos del negocio y cliente -->
        <table>
            <tr>
                <td>
                    <p class="title">@Model.negocio.Nombre.ToUpper()</p>
                    <p class="text">Dirección: @Model.negocio.Direccion</p>
                    <p class="text">Correo: @Model.negocio.Correo</p>
                </td>
                <td style="text-align:right">
                    <p class="title">CLIENTE</p>
                    <p class="text">@Model.venta.NombreCliente</p>
                    <p class="text">@Model.venta.DocumentoCliente</p>
                </td>
            </tr>
        </table>

        <br />

        <!-- Tabla de productos -->
        <table class="tbproductos">
            <thead>
                <tr>
                    <th class="tbth">Producto</th>
                    <th class="tbth" style="width:130px">Cantidad</th>
                    <th class="tbth" style="width:130px">Precio</th>
                    <th class="tbth" style="width:130px">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.venta.DetalleVenta)
                {
                    <tr>
                        <td class="td-item"><p class="item">@item.DescripcionProducto</p></td>
                        <td class="td-item"><p class="item">@item.Cantidad</p></td>
                        <td class="td-item"><p class="item">@Model.negocio.SimboloMoneda @item.Precio</p></td>
                        <td style="background-color:#EDF6F9"><p class="item">@Model.negocio.SimboloMoneda @item.Total</p></td>
                    </tr>
                }

                <tr>
                    <td colspan="2" rowspan="3"></td>
                    <td class="td-item"><p class="item-2">Sub Total</p></td>
                    <td class="item-3">@Model.negocio.SimboloMoneda @Model.venta.SubTotal</td>
                </tr>
                <tr>
                    <td class="td-item"><p class="item-2">IVA</p></td>
                    <td class="item-3">@Model.negocio.SimboloMoneda @Model.venta.ImpuestoTotal</td>
                </tr>
                <tr>
                    <td class="item-3">Total</td>
                    <td class="item-3">@Model.negocio.SimboloMoneda @Model.venta.Total</td>
                </tr>
            </tbody>
        </table>

    </div>

</body>
</html>
