@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Restablecer Clave</title>
    <style>
        body {
            background-color: #EDF6FF;
            font-family: 'Nunito', Arial, Helvetica, sans-serif;
            margin: 0;
            padding: 0;
        }

        .contenedor {
            width: 400px;
            margin: 60px auto;
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
            padding: 25px 30px;
        }

        h2 {
            color: #004DAF;
            text-align: center;
            margin-bottom: 15px;
        }

        h4 {
            color: #004DAF;
            margin: 2px 0;
            font-weight: 600;
        }

        p {
            font-size: 14px;
            color: #555;
            margin: 5px 0;
        }

        .alerta {
            background-color: #FFE1CE;
            padding: 15px;
            margin: 20px 0 0 0;
            border-radius: 8px;
            color: #F45E00;
            font-weight: 500;
            text-align: center;
        }

        table {
            width: 100%;
            margin-top: 10px;
        }

        td {
            padding: 5px 0;
            vertical-align: middle;
        }

        .clave {
            font-weight: bold;
            color: #333;
        }

        a.boton {
            display: inline-block;
            margin-top: 15px;
            padding: 10px 20px;
            background-color: #03A99F;
            color: #fff;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            transition: background 0.3s ease;
        }

            a.boton:hover {
                background-color: #028A7A;
            }
    </style>
</head>
<body>
    <div class="contenedor">
        <table>
            <tr>
                <td colspan="2">
                    <h2>Contraseña Restablecida</h2>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <p>Su contraseña ha sido restablecida correctamente:</p>
                </td>
            </tr>
            <tr>
                <td><h4>Nueva Contraseña:</h4></td>
                <td class="clave">@ViewData["Clave"]</td>
            </tr>
        </table>
        <div class="alerta">
            Le recomendamos cambiar la contraseña una vez inicie sesión.
        </div>
        @* Opcional: botón de ir al login *@
        @if (ViewData["Url"] != null)
        {
            <a href="@ViewData["Url"]" class="boton">Iniciar Sesión</a>
        }
    </div>
</body>
</html>
